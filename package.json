{
  "name": "kite-browser",
  "productName": "Kite",
  "version": "0.1.0",
  "description": "Kite \u2014 a calm, offline, sidebar-first web browser.",
  "author": "Mayank Jha",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "web": "vite --port 5174",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.web.config.ts",
    "test:electron": "npm run build && playwright test -c playwright.electron.config.ts",
    "test:all": "npm run typecheck && npm test && npm run test:e2e && npm run test:electron",
    "dist": "npm run build && electron-builder --mac --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "icon": "node scripts/make-icon.mjs",
    "test:report": "node scripts/test-report.mjs",
    "test:report:quick": "node scripts/test-report.mjs --quick",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "test:packaged": "playwright test -c playwright.electron.config.ts tests/electron/packaged.spec.ts"
  },
  "dependencies": {
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "@fontsource/figtree": "^5.1.1",
    "@ghostery/adblocker": "^2.20.3",
    "@playwright/test": "^1.63.0",
    "@tiptap/extension-link": "^2.10.3",
    "@tiptap/extension-placeholder": "^2.10.3",
    "@tiptap/extension-task-item": "^2.10.3",
    "@tiptap/extension-task-list": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "~45.5.0",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.24.0",
    "fflate": "^0.8.3",
    "immer": "^10.1.1",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^4.5.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "com.mayankjha.kite",
    "productName": "Kite",
    "copyright": "Copyright \u00a9 2026 Mayank Jha",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/koffi/{src,vendor,doc,lib}/**",
      "!node_modules/koffi/build/koffi/{freebsd,openbsd,musl,win32}_*/**",
      "!node_modules/koffi/build/koffi/linux_{arm64,armhf,ia32,loong64,riscv64d}/**"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationUsageDescription": "Websites you allow can use your location.",
        "NSDownloadsFolderUsageDescription": "Kite saves exports and downloads here."
      },
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "protocols": [
      {
        "name": "Web page",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML document",
        "role": "Viewer"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "maintainer": "Mayank Jha",
      "synopsis": "A calm, sidebar-first web browser",
      "desktop": {
        "entry": {
          "MimeType": "x-scheme-handler/http;x-scheme-handler/https;text/html"
        }
      }
    },
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
